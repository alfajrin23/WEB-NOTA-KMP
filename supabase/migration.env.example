# Copy these values into your current PowerShell session before migration.
# Do not commit real database URLs or API keys.

# Old Supabase project, from Dashboard > Project Settings > Database > Connection string.
SOURCE_DATABASE_URL=postgresql://postgres.SOURCE_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# New Supabase project on the new account, from Dashboard > Project Settings > Database > Connection string.
TARGET_DATABASE_URL=postgresql://postgres.TARGET_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Region used only when a direct db.<ref>.supabase.co URL must be converted to Session Pooler.
SOURCE_SUPABASE_POOLER_REGION=ap-southeast-1
TARGET_SUPABASE_POOLER_REGION=ap-southeast-1

# After migration, update .env.local with the new project values:
NEXT_PUBLIC_SUPABASE_URL=https://TARGET_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_NEW_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_NEW_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres.TARGET_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
