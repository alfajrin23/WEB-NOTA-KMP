  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "belanja:check": "tsx automation/belanja-runner/index.ts check",
    "belanja:inspect": "tsx automation/belanja-runner/index.ts inspect",
    "belanja:runner": "tsx automation/belanja-runner/index.ts run",
    "test:date-shift": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/project-date-shift.test.mjs",
